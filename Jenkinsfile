
pipeline {
    agent any

    stages {
        stage('Checkout SCM') {
            steps {
                echo 'Source code is managed by GitHub!'
            }
        }

        stage('Build') {
            steps {
                echo 'Jenkins SCM Pipeline is working!'
            }
        }

        stage('Test') {
            steps {
                echo 'Test completed successfully!'
            }
        }
    }
}